{
  "name": "dsh-skill-install",
  "version": "0.1.3",
  "description": "DeepSeek Harness 技能安装器：按名字搜索或直接输入 GitHub 仓库地址，列出仓库中的 SKILL.md 技能，勾选后安装到全局 / 当前项目 / 自定义目录，与内置 skill-filesystem 联动，装完即时生效。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joey-K-tsubame/dsh-skill-install.git"
  },
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "skill-install"
  ],
  "files": [
    "index.js",
    "client.js",
    "js-yaml.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.0-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
